# Copy to .env.deploy (gitignored) and fill in before running: npm run deploy:cloud
NHOST_SUBDOMAIN=your-subdomain
NHOST_REGION=ap-southeast-1

# Nhost Dashboard → your project → Settings → Hasura → Admin secret
# Quote the value if it contains special characters: HASURA_GRAPHQL_ADMIN_SECRET='...'
HASURA_GRAPHQL_ADMIN_SECRET=paste-your-hasura-admin-secret-here

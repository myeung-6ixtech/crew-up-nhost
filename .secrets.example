# Copy to `.secrets` for local development. Never commit real secrets.
GRAFANA_ADMIN_PASSWORD='grafana-admin-password'
HASURA_GRAPHQL_ADMIN_SECRET='nhost-admin-secret'
NHOST_JWT_KID='49C0CEDD-255D-43DA-8880-30440B24F784'
NHOST_WEBHOOK_SECRET='nhost-webhook-secret'

# Google OAuth (Auth → sign-in provider). Create in Google Cloud Console, then paste here.
# See README § Google OAuth.
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# Venue search for meets. Enable Places API (New) and restrict this key to that API.
# Server-side only — never ship to mobile. Cloud: nhost secrets create GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY=''

# Optional function integrations (stubs until wired)
FCM_SERVER_KEY=''
APNS_KEY=''

# Flight search + trip selection (server-side only — never ship to mobile)
RAPIDAPI_KEY=''
RAPIDAPI_AERODATABOX_HOST='aerodatabox.p.rapidapi.com'
AVIATIONSTACK_API_KEY=''
FLIGHT_PROVIDER='aerodatabox'
FLIGHT_SELECTION_SIGNING_SECRET='change-me-in-production'
# Max route/date rows the daily schedule cache refresh may re-fetch per run.
FLIGHT_CACHE_REFRESH_BUDGET='25'
# Minimum spacing between upstream provider calls; raise it on tighter plans.
FLIGHT_PROVIDER_MIN_REQUEST_GAP_MS='1500'

# Roster upload extraction (server-side only — never ship to mobile).
# If OPENROUTER_API_KEY and ROSTER_LLM_MODELS are both set, roster upload uses OpenRouter
# even when ROSTER_LLM_PROVIDER is still gemini. Gemini is used only when those two are empty.
ROSTER_LLM_PROVIDER='gemini'
# Used only when ROSTER_LLM_PROVIDER=gemini.
GEMINI_API_KEY=''
ROSTER_LLM_MODEL='gemini-3.1-flash-lite'
# Used only when ROSTER_LLM_PROVIDER=openrouter. Ordered list, first choice first.
# Free models use the :free suffix. Photos need a vision model in this list.
OPENROUTER_API_KEY=''
ROSTER_LLM_MODELS=''
# 'true' sends scans and photos unredacted. Only when that route does not train on inputs.
ROSTER_LLM_ALLOW_RAW_FILES='false'

# Onboarding mode: 'beta' (sign-up ends on the holding screen) or 'launched'. Flip without a new app build.
CREWUP_APP_MODE='beta'

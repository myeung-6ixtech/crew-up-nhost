{
  "name": "crew-up-nhost",
  "version": "0.1.0",
  "private": true,
  "description": "CrewUp backend — Nhost Postgres, Hasura GraphQL, Auth, Storage, Functions",
  "scripts": {
    "nhost:up": "nhost up",
    "nhost:down": "nhost down",
    "nhost:logs": "nhost logs",
    "config:validate": "nhost config validate",
    "deploy:cloud": "bash scripts/apply-cloud-schema.sh",
    "deploy:auth": "bash scripts/deploy-auth-config.sh",
    "deploy:all": "bash scripts/deploy-all.sh",
    "verify:schema": "bash scripts/verify-cloud-schema.sh",
    "test:trips": "node --experimental-strip-types --test scripts/trip-selection.test.mjs",
    "test:flights": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs --test scripts/flight-schedules.test.mjs",
    "test:connections": "node --experimental-strip-types --test scripts/connection-requests.test.mjs",
    "test:roster": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs --test scripts/roster-extraction.test.mjs",
    "test:onboarding": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs --test scripts/onboarding.test.mjs",
    "test:event-pin": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs --test scripts/event-pin.test.mjs",
    "test:account-deletion": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs --test scripts/account-deletion.test.mjs",
    "seed:reviewer": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/seed-demo-reviewer.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "build:emails": "node scripts/build-emails.mjs",
    "check:emails": "node scripts/build-emails.mjs --check"
  },
  "devDependencies": {
    "@nhost/cli": "^1.45.0"
  }
}
